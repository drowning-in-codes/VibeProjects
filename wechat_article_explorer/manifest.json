{
  "manifest_version": 3,
  "name": "微信读书公众号文章浏览器",
  "version": "0.1.0",
  "description": "在微信读书和公众号文章页浏览已关注公众号的文章。",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://weread.qq.com/*",
    "https://mp.weixin.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weread.qq.com/*",
        "https://mp.weixin.qq.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": [
        "https://weread.qq.com/*",
        "https://mp.weixin.qq.com/*"
      ]
    }
  ]
}
