# ============================================
# autoTwit 配置文件
# ============================================

# --------------------------------------------
# 必需配置
# --------------------------------------------

# X/Twitter 认证 Token
# 获取方式:
# 1. 登录 https://x.com
# 2. 打开 Chrome DevTools (F12)
# 3. Application > Cookies > https://x.com > auth_token
# 4. 复制 Value 值
X_AUTH_TOKEN=your_auth_token_here

# Anthropic API Key (用于人格分析和内容生成)
# 获取地址: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx

# --------------------------------------------
# 可选配置 - 图片生成
# --------------------------------------------

# OpenAI API Key (用于 DALL-E 图片生成)
# 获取地址: https://platform.openai.com/api-keys
# 不配置则推文无配图
OPENAI_API_KEY=sk-proj-xxx

# Unsplash Access Key (免费图片备选)
# 获取地址: https://unsplash.com/developers
# 不配置则跳过 Unsplash
# UNSPLASH_ACCESS_KEY=your_unsplash_key

# --------------------------------------------
# 可选配置 - API 代理/中转
# --------------------------------------------

# Anthropic API Base URL (使用代理或第三方服务时配置)
# 默认: https://api.anthropic.com
# 示例:
#   - OneAPI: https://oneapi.example.com/v1
#   - 本地代理: http://localhost:8000/v1
# ANTHROPIC_BASE_URL=https://your-proxy.com/v1

# OpenAI API Base URL (使用代理或兼容服务时配置)
# 默认: https://api.openai.com/v1
# 示例:
#   - Azure OpenAI: https://your-resource.openai.azure.com/
#   - OneAPI: https://oneapi.example.com/v1
#   - Cloudflare: https://gateway.ai.cloudflare.com/v1/xxx/xxx/openai
#   - 本地代理: http://localhost:8000/v1
# OPENAI_BASE_URL=https://your-proxy.com/v1

# --------------------------------------------
# 可选配置 - 知乎 API
# --------------------------------------------

# 知乎开放平台 Access Secret (Bearer Token)
# 获取方式: https://developer.zhihu.com/
# 1. 注册开放平台应用
# 2. 获取 Access Secret 作为 Bearer Token
# 3. 请求时需携带 X-Request-Timestamp 头（秒级时间戳）
# ZHIHU_ACCESS_SECRET=your_access_secret

# --------------------------------------------
# 可选配置 - 网络代理
# --------------------------------------------

# HTTP/HTTPS 代理 (避免 IP 被封)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# --------------------------------------------
# 说明
# --------------------------------------------
# 1. 复制此文件为 .env 后修改配置
# 2. 必需配置: X_AUTH_TOKEN 和 ANTHROPIC_API_KEY
# 3. 图片生成需要配置 OPENAI_API_KEY
# 4. Base URL 仅在使用代理时配置
# 5. 更多文档: docs/API_BASE_URL.md
