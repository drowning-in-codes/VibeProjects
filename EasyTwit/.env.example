# ═══════════════════════════════════════════════════════════════
# EasyTwit 环境变量模板
# 复制为 .env 后填入你的 API Key
# ═══════════════════════════════════════════════════════════════

# ── X/Twitter OAuth 1.0a (XDK) ──────────────────────────
# 在 https://developer.x.com/en/portal/dashboard 创建 App
# "Keys and Tokens" → Consumer Keys → 生成 Access Token & Secret
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
# X_BEARER_TOKEN=               # Bearer Token (趋势等公开接口, 可选)
# X_CLIENT_ID=                  # OAuth 2.0 Client ID (可选)
# X_CLIENT_SECRET=              # OAuth 2.0 Client Secret (可选)
# X_REDIRECT_URI=http://localhost:8080/callback

# ── AI model — Primary ───────────────────────────────────
# 可选值: anthropic（原生 Messages API）或 openai（兼容 Chat Completions）
# 默认值也可在 config.yaml 的 ai.provider 中配置
AI_PROVIDER=anthropic
# 可选；不设置时跟随 AI_PROVIDER
AI_BACKUP_PROVIDER=anthropic
AI_API_KEY=sk-xxxxxxxxxxxxx
# 主模型名；也可在 config.yaml 的 ai.model 中设置
AI_MODEL=claude-sonnet-4-6
# AI_BASE_URL=https://api.anthropic.com  # Anthropic 时可选

# ── AI model — Backup ────────────────────────────────────
# AI_BACKUP_API_KEY=sk-xxxxxxxxxxxxx
# 备用模型名；也可在 config.yaml 的 ai.backup_model 中设置
AI_BACKUP_MODEL=claude-sonnet-4-6
# AI_BACKUP_BASE_URL=https://api.anthropic.com

# ── OpenAI-compatible model (仅 ai.provider=openai 时使用) ─
# 兼容旧变量名：ANTHROPIC_* / MODEL_* 仍可作为回退值

# ── 图片生成 — Gemini 协议 (generateContent) ──────────────
# 模型/站点列表在 config.yaml 的 image.providers 配置 (按优先级)
# GEMINI_API_KEY=sk-xxxxxxxxxxxxx
# 兼容旧变量名 NANOBANANA_API_KEY

# ── 图片生成 — OpenAI 协议 (Chat Completions) ─────────────
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ── Proxy (optional) ─────────────────────────────────────
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
