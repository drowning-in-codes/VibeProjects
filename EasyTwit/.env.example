# ═══════════════════════════════════════════════════════════════
# EasyTwit 环境变量模板
# 复制为 .env 后填入你的 API Key
# ═══════════════════════════════════════════════════════════════

# ── X/Twitter OAuth 1.0a (XDK) ──────────────────────────
# 在 https://developer.x.com/en/portal/dashboard 创建 App
# "Keys and Tokens" → Consumer Keys → 生成 Access Token & Secret
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
# X_BEARER_TOKEN=               # Bearer Token (趋势等公开接口, 可选)
# X_CLIENT_ID=                  # OAuth 2.0 Client ID (可选)
# X_CLIENT_SECRET=              # OAuth 2.0 Client Secret (可选)
# X_REDIRECT_URI=http://localhost:8080/callback

# ── Anthropic (Claude) — Primary ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # 自定义中转站（可选）

# ── Anthropic (Claude) — Backup ──────────────────────────
# ANTHROPIC_BACKUP_API_KEY=sk-ant-xxxxxxxxxxxxx
# ANTHROPIC_BACKUP_BASE_URL=https://api.anthropic.com

# ── nanobanana 图片生成 — Primary ────────────────────────
# Gemini 2.5 Flash Image 协议，通过 autorouter 中转
# NANOBANANA_API_KEY=sk-xxxxxxxxxxxxx
# NANOBANANA_BASE_URL=https://autorouter.io

# ── GPT-Image-2 图片生成 — Backup ────────────────────────
# nanobanana 失败时自动切换
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx
# OPENAI_BASE_URL=https://autorouter.io/v1

# ── Proxy (optional) ─────────────────────────────────────
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
