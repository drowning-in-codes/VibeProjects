# B站直播日报系统 — 环境变量
# 复制此文件为 .env 并填入实际值:  cp .env.example .env

# ── PushPlus ──────────────────────────────────────────
# 获取 Token: https://www.pushplus.plus/
PUSHPLUS_TOKEN=your_pushplus_token_here

# ── AI 大模型 (可选，不配则跳过 AI 总结) ─────────────
# DeepSeek:  https://platform.deepseek.com/
# Qwen:      https://dashscope.aliyun.com/
AI_API_KEY=your_api_key_here
# AI 兼容 OpenAI SDK 的 Base URL
#   DeepSeek 默认:  https://api.deepseek.com/v1
#   Qwen 默认:      https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama 本地:    http://localhost:11434/v1
AI_BASE_URL=https://api.deepseek.com/v1

# ── B站 Cookie (可选，扫码登录自动获取) ──────────────
# 如果已有有效的 SESSDATA，可直接填入跳过扫码
# BILI_SESSDATA=
# BILI_BILI_JCT=
# BILI_DEDEUSERID=
